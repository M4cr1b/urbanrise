# ============================================================================
# UrbanRise Ghana — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this template
# is not. Never put a secret in a NEXT_PUBLIC_ variable — those are compiled
# into the browser bundle.
#
# Without any of this the app runs on the seeded Ghanaian dataset, so every
# screen works before the project is provisioned.
# ============================================================================

# --- 1. App access (Supabase → Project Settings → API) ----------------------
# The project URL and its publishable/anon key. Both are safe in the browser:
# row level security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 2. Database owner access (Supabase → Project Settings → Database) ------
# Connection string, "URI" tab. This is the one that lets migrations, seeding
# and schema changes be run for you — the keys above go through PostgREST,
# which cannot execute DDL (no CREATE TABLE, no extensions, no policies).
#
# Prefer the *Session pooler* URI if it is offered: the direct connection is
# IPv6-only on newer projects and will refuse to connect from many networks.
# Format:
#   postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- 3. Server-side writes (Supabase → Project Settings → API) -------------
# The service_role / secret key. Bypasses RLS, so it is server-only and must
# never be committed or exposed to the client. Used by scripts/notion-sync.ts.
# Optional: if you would rather hand over fewer secrets, the sync can be
# pointed at SUPABASE_DB_URL instead.
SUPABASE_SERVICE_ROLE_KEY=

# --- 4. Notion ingestion ----------------------------------------------------
# Each may be either a Notion database URL (needs NOTION_TOKEN below) or a
# path to a CSV export — the sync accepts both.
NOTION_PROPERTIES_URL=
NOTION_PROFESSIONALS_URL=
NOTION_MATERIALS_URL=

# Internal integration token from notion.so/my-integrations. Only needed if the
# URLs above point at Notion rather than at local CSV exports. Remember to
# share each database with the integration, or it will read as empty.
NOTION_TOKEN=
